{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Configure local Pages development.
    // Configure production bindings and secrets in Cloudflare Pages settings.
    "name": "derforyou",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "pages_build_output_dir": "./build/client",
    "d1_databases": [
        {
            "binding": "D1_DATABASE",
            "database_name": "der",
            "database_id": "5e91e37f-e3fd-4f63-aaee-b6e93025aef7"
        }
    ]
}