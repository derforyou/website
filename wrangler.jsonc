{
    "$schema": "node_modules/wrangler/config-schema.json",
    // This file is the source of truth for Pages bindings and plaintext vars.
    // Configure production secrets in Cloudflare Pages settings.
    "name": "derforyou",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "pages_build_output_dir": "./build/client",
    "vars": {
        "APP_URL": "https://der.my.id",
        "EMAIL_SENDER_NAME": "DER Platform",
        "EMAIL_SENDER_EMAIL": "noreply@notify.der.my.id",
        "ADMIN_EMAIL": "hostmaster@der.my.id,dd@dyzulk.com,dev@dyzulk.com"
    },
    "d1_databases": [
        {
            "binding": "D1_DATABASE",
            "database_name": "der",
            "database_id": "5e91e37f-e3fd-4f63-aaee-b6e93025aef7"
        }
    ]
}