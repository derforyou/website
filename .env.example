APP_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
BREVO_API_KEY=
CLOUDFLARE_API_TOKEN=
