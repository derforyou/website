# D1_DATABASE is provided by the Cloudflare Pages/Wrangler binding in wrangler.jsonc.
# Do not define it in local .env files, otherwise deploys can conflict with the binding name.
# Keep production secrets in Cloudflare Pages settings and plaintext vars in wrangler.jsonc.
