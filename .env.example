APP_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
BREVO_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# D1_DATABASE is provided by Cloudflare Pages/Wrangler binding in wrangler.toml.
# Do not define it in local .env files, otherwise deploys can conflict with the binding name.
# Keep production secrets in Cloudflare Pages project settings, not in committed files.
