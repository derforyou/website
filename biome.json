{
    "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
    "files": {
        "ignore": [
            "worker-configuration.d.ts",
            ".react-router/types/**",
            "build/**"
        ]
    },
    "overrides": [
        {
            "include": [
                "app/components/ui/**"
            ],
            "linter": {
                "rules": {
                    "a11y": {
                        "noLabelWithoutControl": "off"
                    },
                    "style": {
                        "useImportType": "off"
                    }
                }
            }
        }
    ]
}